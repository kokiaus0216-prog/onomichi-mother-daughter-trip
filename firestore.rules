rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTripEditor() {
      return request.auth != null && (
        request.auth.uid == "REPLACE_WITH_KAEDE_UID" ||
        request.auth.uid == "REPLACE_WITH_YUKA_UID" ||
        request.auth.uid == "REPLACE_WITH_OWNER_UID_IF_NEEDED"
      );
    }

    // This is one document, watched in real time by both authorized travelers.
    match /trips/onomichi-2026/itinerary/main {
      allow get: if isTripEditor();
      allow list: if false;
      allow create, update: if isTripEditor()
        && request.resource.data.keys().hasOnly(
          ['items','schemaVersion','updatedAt','updatedBy','updatedName'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // This example intentionally denies all other reads and writes.
    // Merge carefully with existing application rules if reusing a project.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
